# The Ledger — OJS Docker environment
COMPOSE_PROJECT_NAME=ledger

# OJS version tag (pkpofficial/ojs image tag)
OJS_VERSION=stable

# Domains
# Prototype (this stack): theledgereconstatecraft.org
# Production (live site, do not touch): theledgereconstatecraft.com
PROTOTYPE_DOMAIN=theledgereconstatecraft.org

# Internal port OJS listens on — Caddy/reverse proxy sits in front on 80/443
HTTP_PORT=8080

# Database credentials — replace placeholders before first run
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=ojs
MYSQL_USER=ojs
MYSQL_PASSWORD=CHANGE_ME_OJS
